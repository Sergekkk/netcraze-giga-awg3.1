diff --git a/src/compat/crypto/blake2s-awg/include/crypto/blake2s-awg.h b/src/compat/crypto/blake2s-awg/include/crypto/blake2s-awg.h
new file mode 100644
index 0000000..9d6f34e
--- /dev/null
+++ b/src/compat/crypto/blake2s-awg/include/crypto/blake2s-awg.h
@@ -0,0 +1,23 @@
+#ifndef _AWG_COMPAT_BLAKE2S_H
+#define _AWG_COMPAT_BLAKE2S_H
+
+#include <crypto/blake2s.h>
+
+/*
+ * Keenetic 4.9 provides: struct blake2s_state
+ * AmneziaWG source uses: struct blake2s_ctx
+ */
+#define blake2s_ctx blake2s_state
+
+/*
+ * Adapt calling convention to kernel 4.9 blake2s
+ */
+static inline void awg_blake2s(
+	const u8 *key, size_t keylen,
+	const u8 *in, size_t inlen,
+	u8 *out, size_t outlen)
+{
+	blake2s(out, in, key, outlen, inlen, keylen);
+}
+
+#define blake2s(key, keylen, in, inlen, out, outlen) \
+	awg_blake2s((key), (keylen), (in), (inlen), (out), (outlen))
+
+#endif
